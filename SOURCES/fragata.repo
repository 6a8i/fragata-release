# Fragata Host 8.3: the packages of the release and their updates, signed by the Fragata Host key.
[fragata]
name=Fragata Host 8.3
baseurl=https://6a8i.github.io/fragata-host-updates/8.3/x86_64/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fragata

# Updates being tested before their release. Enable it only on test hosts.
[fragata-testing]
name=Fragata Host 8.3 - testing
baseurl=https://6a8i.github.io/fragata-host-updates/8.3-testing/x86_64/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fragata
